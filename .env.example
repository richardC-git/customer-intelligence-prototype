# LLM (leave LLM_PROVIDER empty for search results without AI analysis)
# LLM_PROVIDER: anthropic, openai, gemini, azure, copilot, or m365-copilot
LLM_PROVIDER=
# Model name. For azure, the deployment name. Not used by m365-copilot.
# anthropic only accepts claude-haiku-5-5, to protect the credit.
LLM_MODEL=
# API key. For copilot, a GitHub token. For m365-copilot, a Graph access token.
LLM_API_KEY=
# Required for azure, e.g. https://YOUR-RESOURCE.openai.azure.com/openai/v1
# With openai, points at any OpenAI-compatible service.
LLM_BASE_URL=
# Allows CRM and field sales data to reach the model. Approved for this project.
# Without it, AI analysis is skipped whenever such data is involved.
LLM_ALLOW_INTERNAL_DATA=true

# Search
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Storage (optional; defaults to data/cache.duckdb relative to where the app is run)
CACHE_DB_PATH=
# Imported CRM and competitor data (optional; defaults to data/private/sfs.duckdb)
PRIVATE_DB_PATH=